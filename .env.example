# WeatherMood Environment Variables Template
# Copy this file to .env and insert your personal API key

# WeatherAPI Key (Get free key at: https://www.weatherapi.com/)
WEATHER_API_KEY=your_weatherapi_key_here

# Vercel Deployment Token (Optional, for CLI deployments)
VERCEL_TOKEN=your_vercel_token_here

# Local Server Port
PORT=3000
